# Copy to .env.local and fill in. Never commit real values.
# All variables are server-only — do NOT prefix any of them with NEXT_PUBLIC_.

# Required for /gallery, /detections and their API routes
AWS_REGION=
S3_BUCKET_NAME=

# Optional: S3-compatible endpoint for non-AWS storage, e.g. Supabase:
#   https://<project-ref>.storage.supabase.co/storage/v1/s3
# Leave empty for Amazon S3.
S3_ENDPOINT=

# Optional: only list objects under this prefix (e.g. "captures/")
S3_IMAGE_PREFIX=

# Folder that birdnet/birdnet_server.py uploads runs into (used by /detections).
S3_DETECTIONS_PREFIX=detections/

# Credentials. Locally these can come from here or from ~/.aws/credentials.
# For Supabase use the S3 access key pair from Project Settings → Storage.
# On Vercel prefer OIDC federation (an IAM role) over long-lived keys where possible.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: ONLY if the bucket (or a CloudFront distribution in front of it) is intentionally
# public-read. When set, gallery URLs use this base instead of presigned URLs.
# S3_PUBLIC_BASE_URL=https://cdn.example.com
